public class Main {
    public static void main(String[] args) {

        for (int i = 100; i < 1000; i++) {
            boolean f = true;
            int temp = i;

            while (temp != 0) {
                int d = temp % 10;

                if (d != 2 && d != 3 && d != 5 && d != 7) {
                    f = false;
                    break;
                }

                temp = temp / 10;
            }

            if (f) {
                System.out.println(i);
            }
        }
    }
}
